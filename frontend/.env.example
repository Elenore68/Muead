# Copy this file to ".env.local" (git-ignored) and fill in the values printed by `cdk deploy`.
# These are public identifiers, not secrets. Never put passwords, tokens or AWS keys here.
#
# If ANY of the three values is missing, the app runs in mock mode (static demo data, no sign-in).

# API Gateway URL including the stage, e.g. https://abc123.execute-api.us-east-1.amazonaws.com/v1
VITE_API_BASE_URL=
# Cognito user pool ID, e.g. us-east-1_AbCdEfGhI
VITE_COGNITO_USER_POOL_ID=
# Cognito app client ID (the "WebClient")
VITE_COGNITO_CLIENT_ID=
